# Paths to Google Drive synced folders 
AUTO_DETECT_GDRIVE=false
PAPERS_DIR=./mock_drive/papers
OUTPUT_DIR=./mock_drive/output

# Local Database Path
DB_PATH=./data/papers.db

# Local LLM Configuration (Ollama default: http://localhost:11434/v1 | LM Studio: http://localhost:1234/v1)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b

# Discord Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here